# ── Server ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Anthropic AI ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model to use (default: claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Max tokens per AI response (default: 1000)
ANTHROPIC_MAX_TOKENS=1000

# Retry config
ANTHROPIC_MAX_RETRIES=3
ANTHROPIC_RETRY_DELAY_MS=1000

# Request timeout in ms (default: 30000)
ANTHROPIC_TIMEOUT_MS=30000

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate limits (requests per minute) ─────────────────────────────────────────
RATE_LIMIT_API=60
RATE_LIMIT_AI=10
RATE_LIMIT_GENERATE=3

# ── Token plan limits (monthly) ────────────────────────────────────────────────
PLAN_FREE_TOKENS=100000
PLAN_PRO_TOKENS=500000
PLAN_TEAM_TOKENS=2000000

# ── Optional: Redis (for production session/rate-limit storage) ────────────────
# REDIS_URL=redis://localhost:6379
